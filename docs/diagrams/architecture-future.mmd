%% PROPOSED architecture - NOT implemented. It shows where the known limits of v1.1 would be removed.
flowchart TB
  classDef ext fill:#eef2ff,stroke:#4f46e5,color:#1e1b4b
  classDef code fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef store fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef gate fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
  classDef human fill:#f5f3ff,stroke:#7c3aed,color:#3b0764
  classDef todo stroke-dasharray: 5 4

  form["Web form"]:::ext
  edge["Edge proxy<br/>origin check, Turnstile,<br/>rate limit, consent log"]:::gate
  hook["n8n Webhook"]:::gate
  val["Validate and normalise<br/>(same code as today)"]:::code
  pg[("PostgreSQL<br/>UNIQUE(submission_id)<br/>INSERT ... ON CONFLICT DO NOTHING")]:::store
  queue["Work queue<br/>(rows in status recibido)"]:::store
  worker["Scheduled worker<br/>retries, bounded attempts"]:::code
  red["Redact, then model"]:::code
  groq["LLM provider<br/>with a data-processing agreement"]:::ext
  eval["Validate and score<br/>(same code as today)"]:::code
  crm["CRM or ticketing tool<br/>after human approval"]:::human
  obs["Alerts and dashboards<br/>error workflow, metrics"]:::gate
  consent[("Consent record<br/>verifiable, with notice version")]:::store

  form --> edge --> hook --> val --> pg
  edge --> consent
  pg --> queue --> worker --> red --> groq --> eval --> pg
  eval --> crm
  worker --> obs
  hook --> obs
  class pg,queue,worker,crm,obs,consent,edge todo

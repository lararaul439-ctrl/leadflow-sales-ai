%% LeadFlow Sales AI v1.1 - what is implemented today. Edit this file and run: npm run docs:diagrams
flowchart TB
  classDef ext fill:#eef2ff,stroke:#4f46e5,color:#1e1b4b
  classDef code fill:#ecfdf5,stroke:#059669,color:#064e3b
  classDef store fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef gate fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
  classDef human fill:#f5f3ff,stroke:#7c3aed,color:#3b0764

  form["Web form or API client"]:::ext
  proxy["Optional proxy (reference Worker, not deployed)<br/>keeps the token server-side"]:::ext
  hook["n8n Webhook<br/>Header Auth token"]:::gate
  val["Validate and normalise<br/>strict schema, size limits, injection analysis, throttle"]:::code
  look[("Sheets: leads<br/>history lookup")]:::store
  dec["Decide duplicate<br/>per-contact limit"]:::code
  claim[("Sheets: claims<br/>insert, then verify")]:::store
  res{"Claim won?"}:::gate
  rec[("Sheets: leads<br/>status = recibido")]:::store
  red["Redact for the model<br/>no e-mail, phone, links, name or company"]:::code
  groq["Groq<br/>structured JSON output"]:::ext
  eval["Validate the answer, then score<br/>quotes must exist in the message, rules set the priority"]:::code
  task[("Sheets: seguimiento<br/>task + draft")]:::store
  lead[("Sheets: leads<br/>final state")]:::store
  person["Person reviews, edits and sends"]:::human

  r422["HTTP 422 / 413 / 429"]:::ext
  r200["HTTP 200 duplicate<br/>or 503 in progress"]:::ext
  r202["HTTP 202 accepted"]:::ext
  err[("Sheets: errores<br/>bounded, scrubbed")]:::store

  form --> proxy --> hook
  form -.->|"direct, token required"| hook
  hook --> val --> look --> dec --> claim --> res
  val -->|"invalid or throttled"| r422
  dec -->|"duplicate"| r200
  res -->|"lost"| r200
  res -->|"won"| rec
  rec --> r202
  rec --> red --> groq --> eval
  eval --> task --> lead
  task --> person
  eval -->|"any failure"| err

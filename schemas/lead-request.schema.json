{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LeadFlow Sales AI - lead request body",
  "description": "Strict request schema enforced by the \"Validar y normalizar\" node. Generated by scripts/build-workflow.js from src/lead-core.js.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 20,
  "required": [
    "full_name",
    "email",
    "message"
  ],
  "properties": {
    "full_name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 2
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "format": "email"
    },
    "message": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 10,
      "description": "Cleaned and truncated to 2000 characters."
    },
    "company": {
      "type": "string",
      "maxLength": 160
    },
    "phone": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 40
        },
        {
          "type": "integer"
        }
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 60
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "lt_1k",
        "1k_5k",
        "5k_20k",
        "gte_20k",
        "unknown"
      ]
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "immediate",
        "short",
        "long",
        "unknown"
      ]
    },
    "company_size": {
      "type": "string",
      "enum": [
        "1_10",
        "11_50",
        "51_200",
        "gt_200",
        "unknown"
      ]
    },
    "consent_to_contact": {
      "description": "Consent as DECLARED by the caller. It is never treated as verified.",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "true",
            "yes",
            "si",
            "sí",
            "1",
            "on",
            "y",
            "accepted",
            "false",
            "no",
            "0",
            "off",
            "n",
            ""
          ]
        }
      ]
    },
    "consent_notice_version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$"
    },
    "consent_given_at": {
      "type": "string",
      "maxLength": 40,
      "description": "ISO 8601 date or date-time supplied by the form back end. Ignored if in the future or older than 366 days."
    }
  }
}

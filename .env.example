# Only used by `npm run demo:send` (scripts/send-demo.js). Never commit real values.
# Production URL of your n8n webhook, e.g. https://YOUR-INSTANCE.app.n8n.cloud/webhook/leadflow-sales
WEBHOOK_URL=
# Value of the Header Auth credential you created in n8n (header name: X-Webhook-Token)
WEBHOOK_TOKEN=
